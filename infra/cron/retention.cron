# Enforce tenant retention periods and remove expired credentials, daily at 03:15.
# Install with: crontab infra/cron/retention.cron   (adjust the repository path; variables come from .env)
15 3 * * * cd /path/to/repo && set -a && . ./.env && set +a && PYTHONPATH=apps/api .venv/bin/python -m app.services.retention >> var/retention.log 2>&1
