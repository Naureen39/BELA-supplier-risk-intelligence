# SEC fair access requires a declared User-Agent with organization name and contact email.
# Example: "Example Org research contact@example.org"
SEC_USER_AGENT=
# Contact string appended to the User-Agent for all other fetchers.
CONTACT_EMAIL=
# Optional: openFDA API key (raises rate limits).
OPENFDA_API_KEY=
# Optional: Department of Labor data portal API key (see docs/adr/ADR-003-osha-access.md).
DOL_API_KEY=

# --- API (Phase 5) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/provenance
# Valkey (rate limits and live alerts). Empty means in-process, single instance only.
VALKEY_URL=
# Ed25519 private key in PEM form (openssl genpkey -algorithm ED25519). Required outside development.
JWT_PRIVATE_KEY_PEM=
# Secret for MFA secrets, recovery code hashes, and encrypted supplier identifiers.
DATA_KEY=
CURSOR_SECRET=
# Set to false only for plain-HTTP local development; cookies are Secure by default.
COOKIE_SECURE=true
# Development only: generate throwaway signing and encryption keys at startup.
ALLOW_EPHEMERAL_SECRETS=false
TRUST_PROXY_HEADERS=false
SMTP_HOST=
SMTP_PORT=1025
WEB_BASE_URL=https://localhost
